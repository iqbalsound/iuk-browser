{
  "manifest_version": 2,
  "name": "IUK Browser Sync & Vault",
  "version": "0.1.0",
  "description": "End-to-end encrypted bookmark and password sync with a built-in password manager, themes and color invert.",
  "browser_specific_settings": {
    "gecko": {
      "id": "iuk-browser@iuk.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "alarms",
    "theme",
    "clipboardWrite",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "shared/common.js",
      "background/crypto.js",
      "background/merge.js",
      "background/bookmarks.js",
      "background/core.js",
      "background/main.js"
    ]
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "IUK Browser",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "shared/common.js",
        "content/invert.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/autofill.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Fill the saved login on this page"
    },
    "toggle-invert": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Toggle color invert on all sites"
    }
  }
}